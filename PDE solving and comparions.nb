            RowBox[{"FourierParameters", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", 
               RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}]}], ";", "\n", "  ", 
        RowBox[{"error", " ", "=", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"numerical", " ", "-", " ", "exact"}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"{", 
