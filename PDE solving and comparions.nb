             RowBox[{"[", "j", "]"}], "]"}], " ", "=", " ", 
            RowBox[{"Cos", "[", "grid", "]"}]}], ";", "\n", "   ", 
           RowBox[{"rhs", " ", "+=", " ", 
            RowBox[{
             RowBox[{"convection", "[", 
              RowBox[{"[", "j", "]"}], "]"}], " ", 
             RowBox[{"Outer", "[", 
              RowBox[{"Times", ",", " ", 
               RowBox[{"Sequence", " ", "@@", " ", "vectors"}]}], "]"}]}]}]}],
           ",", "\n", "   ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "dim"}], "}"}]}], "\n", "   ", "]"}], ";", 
        "\n", "  ", 
        RowBox[{"terms", " ", "=", " ", 
         RowBox[{"Table", "[", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"diffusion", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], " ", 
             RowBox[{"symbols", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], " ", "+", " ", 
            RowBox[{
             RowBox[{"convection", "[", 
              RowBox[{"[", "j", "]"}], "]"}], " ", 
             RowBox[{"symbols", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], ",", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "dim"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"denominator", " ", "=", " ", 
         RowBox[{"rho", " ", "+", " ", 
          RowBox[{"Outer", "[", 
           RowBox[{"Plus", ",", " ", 
            RowBox[{"Sequence", " ", "@@", " ", "terms"}]}], "]"}]}]}], ";", 
        "\n", "  ", 
        RowBox[{"numerical", " ", "=", " ", 
         RowBox[{"Re", "@", 
          RowBox[{"InverseFourier", "[", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"Fourier", "[", 
              RowBox[{"rhs", ",", " ", 
               RowBox[{"FourierParameters", " ", "->", " ", 
