Cell[CellGroupData[{

Cell["Appended comparisons: Parts 5-7", "Section",ExpressionUUID->"75dd1267-6c16-7144-9a0d-d77d0880241b"],

Cell["\<\
Evaluate Parts 1-4 first, then evaluate the three appended input cells in \
order. If Parts 1-4 have already been evaluated in the current kernel and \
their parameters have not changed, evaluate only Parts 5-7. Part 5 reuses the \
original RBF-HFD convergence data and compares it with Compact FD4 and \
Centered FD2. Part 6 adds a small periodic variable-coefficient comparison. \
All numerical calculations use machine precision. Part 7 provides optional \
EPS and CSV exports.\
\>", "Text",
 CellChangeTimes->{
  4.003815975529478*^9},ExpressionUUID->"d6c4229f-8d8c-d84d-8b84-\
0f7e444358f9"],

Cell[CellGroupData[{

Cell["Part 5. Comparisons for the original 3D and 4D problem", "Subsection",ExpressionUUID->"67810e4e-4700-7c45-8d88-1c573211e7ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"PART", " ", "5"}], ":", " ", 
     RowBox[{
     "comparisons", " ", "for", " ", "the", " ", "original", " ", "periodic", 
      " ", "CDR", " ", 
      RowBox[{"problem", ".", "\n", "   ", "Evaluate"}], " ", "the", " ", 
      "original", " ", "four", " ", "parts", " ", 
      RowBox[{"first", ".", " ", "Existing"}], " ", "definitions", " ", "and",
       " ", "results", "\n", "   ", "are", " ", "preserved"}]}], ";", " ", 
    RowBox[{
     RowBox[{"the", " ", "proposed"}], "-", 
     RowBox[{"method", " ", "table", " ", "is", " ", "reused", " ", "from", " ", 
      RowBox[{"results", "."}]}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cmpMethods", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Proposed RBF-HFD\>\"", ",", " ", "\"\<Compact FD4\>\"", ",",
        " ", "\"\<Centered FD2\>\""}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cmpSymbols", "[", 
      RowBox[{"method_String", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"h", ",", " ", "theta"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"h", " ", "=", " ", 
         RowBox[{"2.", " ", 
          RowBox[{"Pi", "/", "n"}]}]}], ";", "\n", "  ", 
        RowBox[{"theta", " ", "=", " ", 
         RowBox[{"2.", " ", "Pi", " ", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"n", " ", "-", " ", "1"}]}], "]"}], "/", "n"}]}]}], ";", 
        "\n", "  ", 
        RowBox[{"Switch", "[", 
         RowBox[{
         "method", ",", "\n", "   ", "\"\<Proposed RBF-HFD\>\"", ",", "\n", 
          "   ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"firstDerivativeSymbol", "[", 
             RowBox[{"n", ",", " ", "c"}], "]"}], ",", " ", 
            RowBox[{"secondDerivativeSymbol", "[", 
             RowBox[{"n", ",", " ", "c"}], "]"}]}], "}"}], ",", "\n", 
          "   ", "\"\<Compact FD4\>\"", ",", "\n", "   ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"3.", " ", "I", " ", 
             RowBox[{
              RowBox[{"Sin", "[", "theta", "]"}], "/", 
              RowBox[{"(", 
               RowBox[{"2.", " ", "h", " ", 
                RowBox[{"(", 
                 RowBox[{"1.", " ", "+", " ", 
                  RowBox[{"0.5", " ", 
                   RowBox[{"Cos", "[", "theta", "]"}]}]}], ")"}]}], ")"}]}]}],
             ",", "\n", "    ", 
            RowBox[{"12.", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Cos", "[", "theta", "]"}], " ", "-", " ", "1."}], 
               ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"5.", " ", 
                RowBox[{"h", "^", "2"}], " ", 
                RowBox[{"(", 
                 RowBox[{"1.", " ", "+", " ", 
                  RowBox[{"0.2", " ", 
                   RowBox[{"Cos", "[", "theta", "]"}]}]}], ")"}]}], 
               ")"}]}]}]}], "}"}], ",", "\n", "   ", "\"\<Centered FD2\>\"", ",",
           "\n", "   ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"I", " ", 
             RowBox[{
              RowBox[{"Sin", "[", "theta", "]"}], "/", "h"}]}], ",", " ", 
            RowBox[{"2.", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Cos", "[", "theta", "]"}], " ", "-", " ", "1."}], 
               ")"}], "/", 
              RowBox[{"h", "^", "2"}]}]}]}], "}"}]}], "\n", "   ", "]"}]}]}], 
      "\n", "  ", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cmpPeriodicCase", "[", 
      RowBox[{
      "method_String", ",", " ", "dim_Integer", ",", " ", "n_Integer"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "h", ",", " ", "grid", ",", " ", "diffusion", ",", " ", "convection", 
         ",", " ", "symbols", ",", " ", "sineVectors", ",", " ", "exact", ",",
          " ", "rhs", ",", "\n", "   ", "vectors", ",", " ", "terms", ",", 
         " ", "denominator", ",", " ", "numerical", ",", " ", "error"}], 
        "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"h", " ", "=", " ", 
         RowBox[{"2.", " ", 
          RowBox[{"Pi", "/", "n"}]}]}], ";", "\n", "  ", 
        RowBox[{"grid", " ", "=", " ", 
         RowBox[{"h", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"n", " ", "-", " ", "1"}]}], "]"}]}]}], ";", "\n", "  ", 
        RowBox[{"diffusion", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"1.", " ", "+", " ", 
            RowBox[{"0.2", " ", 
             RowBox[{"(", 
              RowBox[{"j", " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "dim"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"convection", " ", "=", " ", 
         RowBox[{"Take", "[", 
          RowBox[{"bAll", ",", " ", "dim"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"symbols", " ", "=", " ", 
         RowBox[{"cmpSymbols", "[", 
          RowBox[{"method", ",", " ", "n"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"sineVectors", " ", "=", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"Sin", "[", "grid", "]"}], ",", " ", "dim"}], "]"}]}], ";",
         "\n", "  ", 
        RowBox[{"exact", " ", "=", " ", 
         RowBox[{"Outer", "[", 
          RowBox[{"Times", ",", " ", 
           RowBox[{"Sequence", " ", "@@", " ", "sineVectors"}]}], "]"}]}], ";",
         "\n", "  ", 
        RowBox[{"rhs", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"rho", " ", "+", " ", 
            RowBox[{"Total", "[", "diffusion", "]"}]}], ")"}], " ", 
          "exact"}]}], ";", "\n", "  ", 
        RowBox[{"Do", "[", "\n", "   ", 
         RowBox[{
          RowBox[{
           RowBox[{"vectors", " ", "=", " ", "sineVectors"}], ";", "\n", 
