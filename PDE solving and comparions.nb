Cell[CellGroupData[{

Cell["Part 7. Optional EPS and CSV exports", "Subsection",ExpressionUUID->"2ad58526-ac64-bb43-bd09-46a3e33388f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"PART", " ", "7"}], ":", " ", 
    RowBox[{"optional", " ", 
     RowBox[{"exports", ".", " ", "Set"}], " ", "this", " ", "flag", " ", 
     "to", " ", "True", " ", "to", " ", "save", " ", "the", "\n", "   ", 
     "comparison", " ", "figures", " ", "as", " ", "EPS", " ", "and", " ", 
     "the", " ", "unformatted", " ", "numerical", " ", "tables", " ", "as", " ",
      "CSV", "\n", "   ", "in", " ", "a", " ", "new", " ", "subdirectory", " ",
      "next", " ", "to", " ", "this", " ", 
     RowBox[{"notebook", "."}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cmpExportOutputs", " ", "=", " ", "False"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"TrueQ", "[", "cmpExportOutputs", "]"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"cmpOutputDirectory", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", "\n", "   ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", 
           " ", "\"\<RBF_HFD_comparison_outputs\>\""}], "}"}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"DirectoryQ", "[", "cmpOutputDirectory", "]"}]}], ",", "\n",
          "  ", 
         RowBox[{"CreateDirectory", "[", "cmpOutputDirectory", "]"}]}], "]"}],
        ";", "\n", " ", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "cmpOutputDirectory", ",", "\n", 
            "    ", "\"\<Periodic_Comparison_Maximum.eps\>\""}], "}"}], "]"}],
          ",", " ", "cmpPeriodicMaxFigure", ",", " ", "\"\<EPS\>\""}], "]"}], 
       ";", "\n", " ", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "cmpOutputDirectory", ",", "\n", 
            "    ", "\"\<Periodic_Comparison_RMS.eps\>\""}], "}"}], "]"}], ",",
          " ", "cmpPeriodicRMSFigure", ",", " ", "\"\<EPS\>\""}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "cmpOutputDirectory", ",", "\n", 
            "    ", "\"\<Variable_Coefficient_Comparison.eps\>\""}], "}"}], 
          "]"}], ",", " ", "cmpVariableFigure", ",", " ", "\"\<EPS\>\""}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"Do", "[", "\n", "  ", 
        RowBox[{
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"cmpOutputDirectory", ",", "\n", "     ", 
              RowBox[{"\"\<Periodic_d\>\"", " ", "<>", " ", 
               RowBox[{"ToString", "[", "dim", "]"}], " ", "<>", 
               " ", "\"\<_\>\"", " ", "<>", "\n", "      ", 
               RowBox[{"StringReplace", "[", 
                RowBox[{"method", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"\"\< \>\"", " ", "->", " ", "\"\<_\>\""}], ",", 
                   " ", 
                   RowBox[{"\"\<-\>\"", " ", "->", " ", "\"\<_\>\""}]}], 
                  "}"}]}], "]"}], " ", "<>", " ", "\"\<.csv\>\""}]}], "}"}], 
            "]"}], ",", "\n", "   ", 
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"cmpPeriodicResults", "[", "dim", "]"}], "[", "method", 
              "]"}], ",", "\n", "    ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<n\>\"", ",", " ", "\"\<h\>\"", ",", 
               " ", "\"\<maximum error\>\"", ",", " ", "\"\<RMS error\>\""}], 
              "}"}]}], "]"}], ",", " ", "\"\<CSV\>\""}], "]"}], ",", "\n", 
         "  ", 
         RowBox[{"{", 
          RowBox[{"dim", ",", " ", "dimensions"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"method", ",", " ", "cmpMethods"}], "}"}]}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"Do", "[", "\n", "  ", 
        RowBox[{
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"cmpOutputDirectory", ",", "\n", "     ", 
              RowBox[{"\"\<Variable_2D_\>\"", " ", "<>", "\n", "      ", 
               RowBox[{"StringReplace", "[", 
                RowBox[{"method", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"\"\< \>\"", " ", "->", " ", "\"\<_\>\""}], ",", 
                   " ", 
                   RowBox[{"\"\<-\>\"", " ", "->", " ", "\"\<_\>\""}]}], 
                  "}"}]}], "]"}], " ", "<>", " ", "\"\<.csv\>\""}]}], "}"}], 
            "]"}], ",", "\n", "   ", 
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"cmpVariableResults", "[", "method", "]"}], ",", "\n", 
             "    ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<n\>\"", ",", " ", "\"\<h\>\"", ",", 
               " ", "\"\<maximum error\>\"", ",", " ", "\"\<RMS error\>\"", ",",
                "\n", "     ", "\"\<relative algebraic residual\>\""}], 
              "}"}]}], "]"}], ",", " ", "\"\<CSV\>\""}], "]"}], ",", "\n", 
         "  ", 
         RowBox[{"{", 
          RowBox[{"method", ",", " ", "cmpMethods"}], "}"}]}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Comparison figures and tables saved to: \>\"", ",", " ", 
         "cmpOutputDirectory"}], "]"}]}], ",", "\n", " ", 
      RowBox[{
      "Print", "[", "\"\<Optional exports are off. Set cmpExportOutputs = \
True in Part 7 to export EPS and CSV files.\>\"", "]"}]}], "\n", " ", "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"25d57374-423f-7e4a-9aad-1aa5900d538d"],

